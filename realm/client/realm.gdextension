; The native module (realm/godot). realm/check_client.sh, or the CI, builds it and copies it into bin/.
[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/librealm_godot.so"
linux.release.x86_64 = "res://bin/librealm_godot.so"
windows.debug.x86_64 = "res://bin/realm_godot.dll"
windows.release.x86_64 = "res://bin/realm_godot.dll"
