; Engine configuration file.
config_version=5

[application]

config/name="Magic Smash"
config/description="Arcane arena carnage. Up to 4 wizards, local or LAN."
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.05, 0.02, 0.1, 1)
boot_splash/show_image=false

[autoload]

Flags="*res://game/autoload/flags.gd"
Controls="*res://game/autoload/controls.gd"
Save="*res://game/autoload/save.gd"
G="*res://game/autoload/g.gd"
Sfx="*res://game/autoload/sfx.gd"
Net="*res://game/autoload/net.gd"
Platform="*res://game/autoload/platform.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=4
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

textures/vram_compression/import_etc2_astc=true

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.06, 1)
