
# Builds and Python
# Credentials for online services and signing (docs/online.md): never commit them
# Godot
# Godot cache and generated output
*.jks
*.keystore
*.pyc
*.translation
*credentials*.cfg
.godot/
/build/
/builds/
/out/
__pycache__/
config/*credentials*
export_credentials.cfg
tools/music/out/candidates/

# The sentry-godot addon is fetched by tools/fetch_sentry.sh (large native binaries)
/addons/sentry/
/target/
# TLS keys and certificates (the gateway's --dev-cert pair, a real pair): never commit them.
*.pem
*.dev-key.pem
*.dev-cert.pem
*.dev-cert.names
